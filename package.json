{
  "name": "backend-citas-medicas",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "build:start": "npm run build && npm start",
    "test": "jest --config jest.config.js --runInBand",
    "test:unit": "jest --config jest.config.js --testPathPattern=tests/unit",
    "test:integration": "tsx scripts/migrate-test-db.ts && jest --config jest.config.js --testPathPattern=tests/integration --runInBand",
    "test:all": "tsx scripts/migrate-test-db.ts && jest --config jest.config.js --runInBand",
    "test:coverage": "jest --config jest.config.js --coverage --runInBand",
    "db:migrate": "tsx scripts/migrate-dev-db.ts",
    "db:test:migrate": "tsx scripts/migrate-test-db.ts",
    "db:test:reset": "tsx scripts/migrate-test-db.ts --reset"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "jest": "^29.7.0",
    "mysql2": "^3.24.6",
    "prisma": "^6.4.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.15"
  }
}
