# Servidor
PORT=3000
NODE_ENV=development

# Base de datos
DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=
DB_NAME=
DATABASE_URL=

# Correo (SMTP)
# En desarrollo, si SMTP_ENABLED no es "true", el código de verificación
# se imprime en la consola del servidor con el prefijo [DEV][EMAIL].
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Alternativa Gmail (se usan si SMTP_USER/SMTP_PASS están vacíos)
# Usar una "Contraseña de aplicación" de Google:
# https://support.google.com/accounts/answer/185833
GMAIL_USER=
GMAIL_APP_PASSWORD=

# JWT Config
JWT_SECRET=
JWT_EXPIRES_IN=
